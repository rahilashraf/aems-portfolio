# Copy to .env for local development:  cp .env.example .env
# Never commit .env. Values here are development-only placeholders.

# --- Django
DJANGO_SECRET_KEY=dev-only-change-me-generate-with-python-secrets-token-urlsafe-50
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL (docker-compose)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev-only-superuser-password
AEMS_DB_NAME=aems
AEMS_DB_USER=aems_app
AEMS_DB_PASSWORD=dev-only-app-password

# Used when running Django on the host (outside Docker) against the compose database.
DATABASE_URL=postgres://aems_app:dev-only-app-password@localhost:5432/aems

# --- Email (Mailpit UI: http://localhost:8025, SMTP: localhost:1025)
# Host-based Django uses this. Containerized Django overrides it with smtp://mailpit:1025.
# Keep the port in sync with MAILPIT_SMTP_HOST_PORT if you change it.
EMAIL_URL=smtp://localhost:1025
DEFAULT_FROM_EMAIL=AEMS <no-reply@aems.local>

# --- Host ports (optional)
# POSTGRES_HOST_PORT=5432
# BACKEND_HOST_PORT=8000
# MAILPIT_UI_HOST_PORT=8025
# MAILPIT_SMTP_HOST_PORT=1025

# --- Production only (ignored by local settings)
# Trust X-Forwarded-Proto ONLY behind a TLS-terminating reverse proxy that strips and overwrites
# that header on every request. Default: false.
# DJANGO_BEHIND_TLS_PROXY=false
