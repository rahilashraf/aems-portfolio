# AEMS frontend configuration (FE-1A). Copy to .env.local for local overrides; never commit secrets.
# Nothing here is exposed to the browser (no NEXT_PUBLIC_* variables exist).

# Development-only review routes (/dev/ui, /dev/shell). "true" or "false" (default false).
# Refused when VERCEL_ENV=production.
AEMS_ENABLE_DEV_ROUTES=false
